ComboBoxPopupScrollMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 4 0
  color: #1d1d1d
  background-color: alpha
  margin: 1

  $hover !disabled:
    color: #ffffff
    background-color: #355d89

  $disabled:
    color: #6f6b6388

ComboBoxPopupScrollMenu < UIPopupScrollMenu
  background-color: #c9c5bb
  border-width: 1
  border-color: #232323

ComboBoxPopupMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 4 0
  color: #1d1d1d
  background-color: alpha
  margin: 1

  $hover !disabled:
    color: #ffffff
    background-color: #355d89

  $disabled:
    color: #6f6b6388

ComboBoxPopupMenu < UIPopupMenu
  background-color: #c9c5bb
  border-width: 1
  border-color: #232323

ComboBox < UIComboBox
  font: verdana-11px-antialised
  color: #1d1d1d
  size: 91 23
  text-offset: 3 0
  text-align: left
  background-color: #f5f3ed
  border-width: 1
  border-color: #232323

  $hover !disabled:
    background-color: #ffffff

  $on:
    background-color: #e8e4da

  $disabled:
    color: #6f6b6388
    opacity: 0.8
