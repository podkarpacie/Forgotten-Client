Panel < UIWidget
  phantom: true
  auto-focus: first

ScrollablePanel < UIScrollArea
  phantom: true
  auto-focus: first

FlatPanel < Panel
  background-color: #b3afa6
  border-width: 1
  border-color: #232323

ScrollableFlatPanel < ScrollablePanel
  background-color: #b3afa6
  border-width: 1
  border-color: #232323

LightFlatPanel < Panel
  background-color: #d9d5cc
  border-width: 1
  border-color: #232323
