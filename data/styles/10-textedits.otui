TextEdit < UITextEdit
  font: verdana-11px-antialised
  color: #1d1d1d
  size: 86 22
  text-offset: 0 4
  opacity: 1
  padding: 4
  background-color: #f5f3ed
  border-width: 1
  border-color: #232323
  selection-color: #1d1d1d
  selection-background-color: #cccccc
  $disabled:
    color: #6f6b6388
    opacity: 0.5

PasswordTextEdit < TextEdit
  text-hidden: true

MultilineTextEdit < TextEdit
  multiline: true
